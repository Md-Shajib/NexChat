# Chat API — REST base URL (includes the /api prefix).
NEXT_PUBLIC_API_BASE_URL=https://frontend-task-chatapp.onrender.com/api

# Socket.io origin. NOTE: the socket lives at the host ROOT, not under /api.
NEXT_PUBLIC_SOCKET_URL=https://frontend-task-chatapp.onrender.com

# Milliseconds before an in-flight REST request is aborted.
# The API is hosted on a free Render dyno that cold-starts, so keep this generous.
NEXT_PUBLIC_API_TIMEOUT=30000
